---
import { getCollection } from 'astro:content';
import { pagesLabel, sectionPageCount } from '../lib/sections';

// Three landing journeys, in the order of the w18 design: Inicio, Equipo (recommended), Consulta.
// `section` is the sidebar directory of the entry page; its page count is computed at build time.
const entries = await getCollection('docs');
const recorridos = [
	{
		name: 'Inicio',
		href: '/empieza/que-es/',
		section: 'empieza',
		desc: 'Nunca has usado OpenSpec: qué es, conceptos, instalación y tu primer cambio.',
		recommended: false,
	},
	{
		name: 'Equipo',
		href: '/equipo/adopcion/',
		section: 'equipo',
		desc: 'Vas a adoptarlo en un equipo: plan de adopción, Jira o Azure DevOps y CI.',
		recommended: true,
	},
	{
		name: 'Consulta',
		href: '/referencia/cli/',
		section: 'referencia',
		desc: 'Buscas un comando o una plantilla concreta: usa el buscador o la referencia.',
		recommended: false,
	},
].map((r) => ({ ...r, pages: sectionPageCount(entries, r.section) }));
---

<section class="home-seccion not-content" aria-labelledby="recorridos">
	<h2 id="recorridos">¿Desde dónde partes?</h2>
	<div class="recorridos">
		{
			recorridos.map((r) => (
				<a href={r.href} class:list={['recorrido', { recommended: r.recommended }]} data-recorrido={r.name}>
					<span class="meta">
						<span class="path" data-section-pages={r.pages}>
							/{r.section} · {pagesLabel(r.pages)}
						</span>
						{r.recommended && <span class="badge">Recomendado</span>}
					</span>
					<span class="name">{r.name}</span>
					<span class="desc">{r.desc}</span>
				</a>
			))
		}
	</div>
</section>

<style>
	.recorridos {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem;
	}
	.recorrido {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.25rem 1.5rem;
		border: 1px solid var(--os-border);
		border-radius: var(--os-radius);
		background: var(--os-surface);
		text-decoration: none;
		color: var(--sl-color-white);
	}
	.recorrido:hover,
	.recorrido:focus-visible {
		border-color: var(--sl-color-accent);
	}
	.recorrido.recommended {
		border-color: var(--sl-color-accent);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.badge {
		padding: 0.05rem 0.5rem;
		border-radius: 999px;
		background: var(--sl-color-accent-low);
		font-weight: 600;
		text-transform: uppercase;
		color: var(--sl-color-text-accent);
	}
	.name {
		font-size: var(--sl-text-xl);
		font-weight: 600;
	}
	.desc {
		font-size: var(--sl-text-sm);
		line-height: 1.55;
		color: var(--sl-color-gray-2);
	}
	@media (min-width: 50rem) {
		.recorridos {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
