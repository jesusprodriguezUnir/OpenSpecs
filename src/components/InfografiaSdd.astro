---
// One-page summary of OpenSpec, rebuilt from the author's reference image as real text.
// Every string cites the site page it comes from. Content: OpenSpec 1.14 (core profile).
type Icon = keyof typeof icons;
type Item = { icon?: Icon; code?: string; text: string; extended?: boolean };
type Block = {
	title: string;
	color: 'blue' | 'orange' | 'teal' | 'purple';
	icon: Icon;
	kind: 'list' | 'cycle' | 'steps';
	items: Item[];
	links: { href: string; label: string }[];
};

// Decorative line icons (24×24 grid, stroked). Drawn for this component.
const icons = {
	book: ['M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z', 'M4 21V5', 'M8 7h7'],
	files: ['M7 3h7l5 5v13H7z', 'M14 3v5h5', 'M10 13h6', 'M10 17h6'],
	loop: ['M4 12a8 8 0 0 1 14-5.3', 'M18 3v4h-4', 'M20 12a8 8 0 0 1-14 5.3', 'M6 21v-4h4'],
	team: ['M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6z', 'M3 20a6 6 0 0 1 12 0', 'M16 5a3 3 0 0 1 0 6', 'M18 14.5a6 6 0 0 1 3 5.5'],
	git: ['M6 3v12', 'M6 21a2 2 0 1 0 0-4 2 2 0 0 0 0 4z', 'M18 9a2 2 0 1 0 0-4 2 2 0 0 0 0 4z', 'M18 9a9 9 0 0 1-9 9'],
	delta: ['M12 4l9 16H3z'],
	building: ['M4 21V5l8-2v18', 'M12 9h8v12', 'M7 8h2', 'M7 12h2', 'M7 16h2', 'M15 13h2', 'M15 17h2', 'M2 21h20'],
	plug: ['M9 3v5', 'M15 3v5', 'M6 8h12v3a6 6 0 0 1-12 0z', 'M12 17v4'],
	bulb: ['M9 18h6', 'M10 21h4', 'M12 3a6 6 0 0 0-4 10.5V16h8v-2.5A6 6 0 0 0 12 3z'],
	listCheck: ['M4 6h2', 'M4 12h2', 'M4 18h2', 'M9 6h11', 'M9 12h11', 'M9 18h11'],
	layers: ['M12 3l9 5-9 5-9-5z', 'M3 13l9 5 9-5'],
	checkbox: ['M4 4h16v16H4z', 'M8 12l3 3 5-6'],
	search: ['M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14z', 'M21 21l-5-5'],
	docPlus: ['M7 3h7l5 5v13H7z', 'M14 3v5h5', 'M13 12v6', 'M10 15h6'],
	code: ['M8 8l-4 4 4 4', 'M16 8l4 4-4 4', 'M13.5 5l-3 14'],
	check: ['M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z', 'M8 12l3 3 5-6'],
	archive: ['M3 4h18v4H3z', 'M5 8v12h14V8', 'M10 12h4'],
	ticket: ['M3 7h18v10H3z', 'M9 7v10', 'M13 11h5', 'M13 14h3'],
	shield: ['M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z', 'M9 12l2 2 4-4'],
	lock: ['M6 11h12v10H6z', 'M8 11V7a4 4 0 0 1 8 0v4'],
} satisfies Record<string, string[]>;

const blocks: Block[] = [
	{
		title: 'Fundamentos',
		color: 'blue',
		icon: 'book',
		kind: 'list',
		items: [
			// /empieza/que-es/ (description)
			{ icon: 'git', text: 'Humanos y agentes de IA acuerdan qué construir antes de escribir código, y ese acuerdo vive en Git.' },
			// /empieza/que-es/ and /empieza/conceptos/
			{ icon: 'book', code: 'openspec/specs/', text: 'Fuente de verdad: cómo se comporta el sistema hoy, por dominios.' },
			// /empieza/que-es/ and /empieza/conceptos/
			{ icon: 'delta', code: 'openspec/changes/', text: 'Cada cambio es un delta: solo describe lo que añade, modifica o elimina.' },
			// /guias/brownfield/
			{ icon: 'building', text: 'Brownfield primero: se introduce en un proyecto existente con un piloto acotado, sin documentarlo todo de golpe.' },
			// /empieza/instalacion/
			{ icon: 'plug', code: 'openspec init --tools', text: 'Agnóstico de herramienta: admite más de 40 asistentes.' },
		],
		links: [
			{ href: '/empieza/que-es/', label: 'Qué es OpenSpec' },
			{ href: '/guias/brownfield/', label: 'Proyectos existentes' },
		],
	},
	{
		title: 'Los cuatro artefactos de un change',
		color: 'orange',
		icon: 'files',
		kind: 'cycle',
		// /empieza/conceptos/ (table «Changes: la unidad de trabajo») and /guias/formato-de-specs/
		items: [
			{ icon: 'bulb', code: 'proposal.md', text: 'Intención, alcance y enfoque.' },
			{ icon: 'listCheck', code: 'specs/', text: 'Delta specs con requisitos SHALL y escenarios WHEN / THEN.' },
			{ icon: 'layers', code: 'design.md', text: 'Decisiones técnicas.' },
			{ icon: 'checkbox', code: 'tasks.md', text: 'Checklist de implementación con progreso.' },
		],
		links: [
			{ href: '/empieza/conceptos/', label: 'Conceptos' },
			{ href: '/guias/formato-de-specs/', label: 'Formato de specs' },
		],
	},
	{
		title: 'El ciclo diario con /opsx',
		color: 'teal',
		icon: 'loop',
		kind: 'steps',
		// /referencia/comandos-chat/ (core table and «Workflows del perfil ampliado»)
		items: [
			{ icon: 'search', code: '/opsx:explore', text: 'Investiga el problema sin escribir artefactos ni código.' },
			{ icon: 'docPlus', code: '/opsx:propose', text: 'Crea el change con proposal, specs, design y tasks.' },
			{ icon: 'code', code: '/opsx:apply', text: 'Implementa las tareas y las marca al completarlas.' },
			{ icon: 'check', code: '/opsx:verify', text: 'Comprueba que el código cumple specs, design y tasks.', extended: true },
			{ icon: 'archive', code: '/opsx:archive', text: 'Fusiona las delta specs y archiva el change.' },
		],
		links: [
			{ href: '/guias/flujo-opsx/', label: 'Flujo /opsx' },
			{ href: '/referencia/comandos-chat/', label: 'Comandos de chat' },
		],
	},
	{
		title: 'En equipo',
		color: 'purple',
		icon: 'team',
		kind: 'list',
		items: [
			// /equipo/jira/ and /equipo/azure-devops/
			{ icon: 'ticket', text: 'Backlog en Jira o Azure DevOps: el agente lee el ticket vía MCP, en solo lectura.' },
			// /equipo/ci/
			{ icon: 'shield', code: 'openspec validate --all --strict', text: 'En la pipeline de cada PR, con una versión fija de OpenSpec.' },
			// /referencia/plantillas/ (CLAUDE.md rule) and /referencia/comandos-chat/ (sync)
			{ icon: 'lock', code: 'openspec/specs/', text: 'Regla de oro: no se edita a mano; solo cambia con /opsx:archive o /opsx:sync.' },
		],
		links: [
			{ href: '/equipo/jira/', label: 'Jira' },
			{ href: '/equipo/azure-devops/', label: 'Azure DevOps' },
			{ href: '/equipo/ci/', label: 'Validación en CI' },
			{ href: '/equipo/adopcion/', label: 'Adopción' },
		],
	},
];

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['infografia-sdd not-content', className]}>
	<figure class="ig">
		<figcaption class="ig-title">OpenSpec: desarrollo guiado por especificaciones con IA</figcaption>
		<p class="ig-subtitle">Primero se acuerda la spec; después el agente implementa contra ella.</p>
		<div class="ig-grid">
			{
				blocks.map((b, i) => (
					<section class={`ig-block ig-${b.color}`} data-ig-block>
						<h3 class="ig-heading">
							<span class="ig-num">{i + 1}</span>{' '}
							<svg class="ig-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
								{icons[b.icon].map((d) => <path d={d} />)}
							</svg>
							<span class="ig-heading-text">{b.title}</span>
						</h3>

						{b.kind === 'cycle' ? (
							<div class="ig-cycle">
								<p class="ig-hub">Change</p>
								<svg class="ig-ring" viewBox="0 0 100 100" width="100" height="100" aria-hidden="true">
									<circle cx="50" cy="50" r="40" />
									<path d="M85 46l5 6 5-6" />
									<path d="M54 85l-6 5 6 5" />
									<path d="M5 54l5-6 5 6" />
									<path d="M46 5l6 5-6 5" />
								</svg>
								<ul class="ig-cycle-list">
									{b.items.map((it) => (
										<li class="ig-artifact">
											{it.icon && (
												<svg class="ig-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
													{icons[it.icon].map((d) => <path d={d} />)}
												</svg>
											)}
											<code>{it.code}</code>
											<span>{it.text}</span>
										</li>
									))}
								</ul>
							</div>
						) : b.kind === 'steps' ? (
							<ol class="ig-steps">
								{b.items.map((it) => (
									<li class="ig-step">
										{it.icon && (
											<svg class="ig-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
												{icons[it.icon].map((d) => <path d={d} />)}
											</svg>
										)}
										<code>{it.code}</code>
										<span>{it.text}</span>
										{it.extended && <span class="ig-badge">perfil ampliado</span>}
									</li>
								))}
							</ol>
						) : (
							<ul class="ig-list">
								{b.items.map((it) => (
									<li>
										{it.icon && (
											<svg class="ig-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
												{icons[it.icon].map((d) => <path d={d} />)}
											</svg>
										)}
										<span>
											{it.code && <code>{it.code}</code>} {it.text}
										</span>
									</li>
								))}
							</ul>
						)}

						<p class="ig-links">
							Amplía:{' '}
							{b.links.map((l, j) => (
								<>
									<a href={l.href}>{l.label}</a>
									{j < b.links.length - 1 && ' · '}
								</>
							))}
						</p>
					</section>
				))
			}
		</div>
	</figure>
</div>

<style>
	/* Fixed "paper" palette in both themes (design D3). Text pairs ≥ 4.5:1 on white. */
	.infografia-sdd {
		--ig-paper: #ffffff;
		--ig-ink: #1c2b33;
		--ig-muted: #44535b;
		--ig-line: #d3dcdf;
		--ig-blue: #1d5fa8;
		--ig-orange: #b45309;
		--ig-teal: #0f766e;
		--ig-purple: #6b3fa0;
		--ig-scale: 1;
		container-type: inline-size;
		margin: 1.5rem 0;
	}
	.ig {
		margin: 0;
		padding: 1.5em;
		font-size: calc(1rem * var(--ig-scale));
		line-height: 1.45;
		color: var(--ig-ink);
		background: var(--ig-paper);
		border: 1px solid var(--ig-line);
		border-radius: 0.75rem;
		print-color-adjust: exact;
		-webkit-print-color-adjust: exact;
	}
	.ig-title {
		margin: 0;
		font-size: 1.45em;
		font-weight: 700;
		line-height: 1.2;
		color: var(--ig-ink);
		text-align: center;
	}
	.ig-subtitle {
		margin: 0.35em 0 1.25em;
		font-size: 0.95em;
		color: var(--ig-muted);
		text-align: center;
	}
	.ig-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1em;
	}
	.ig-block {
		--ig-c: var(--ig-blue);
		min-width: 0;
		padding: 1em 1.1em;
		border: 1px solid var(--ig-line);
		border-top: 4px solid var(--ig-c);
		border-radius: 0.5rem;
		background: var(--ig-paper);
	}
	.ig-orange {
		--ig-c: var(--ig-orange);
	}
	.ig-teal {
		--ig-c: var(--ig-teal);
	}
	.ig-purple {
		--ig-c: var(--ig-purple);
	}
	.ig-heading {
		display: flex;
		align-items: center;
		gap: 0.5em;
		margin: 0 0 0.75em;
		font-size: 1.1em;
		font-weight: 700;
		line-height: 1.25;
		color: var(--ig-c);
	}
	.ig-num {
		display: inline-grid;
		place-items: center;
		flex: none;
		width: 1.7em;
		height: 1.7em;
		border-radius: 50%;
		font-size: 0.9em;
		color: #ffffff;
		background: var(--ig-c);
	}
	.ig-icon {
		flex: none;
		width: 1.5em;
		height: 1.5em;
		fill: none;
		stroke: var(--ig-c);
		stroke-width: 1.8;
		stroke-linecap: round;
		stroke-linejoin: round;
	}
	.ig code {
		padding: 0.05em 0.3em;
		font-family: var(--sl-font-mono, ui-monospace, monospace);
		font-size: 0.85em;
		color: var(--ig-ink);
		background: #f1f4f5;
		border-radius: 0.25rem;
		overflow-wrap: anywhere;
	}
	.ig-list,
	.ig-steps,
	.ig-cycle-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.ig-list li {
		display: flex;
		align-items: flex-start;
		gap: 0.6em;
		margin: 0 0 0.6em;
		font-size: 0.92em;
	}
	.ig-list li .ig-icon {
		width: 1.35em;
		height: 1.35em;
	}

	/* Block 3: /opsx commands, one per row on narrow screens. */
	.ig-steps {
		display: grid;
		gap: 0.6em;
	}
	.ig-step {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		column-gap: 0.6em;
		row-gap: 0.15em;
		align-items: center;
		font-size: 0.9em;
	}
	.ig-step > span {
		grid-column: 2;
		color: var(--ig-muted);
	}
	.ig-step > code {
		justify-self: start;
		font-weight: 600;
	}
	.ig-step > .ig-badge {
		justify-self: start;
		padding: 0 0.45em;
		font-size: 0.85em;
		font-weight: 600;
		color: var(--ig-purple);
		border: 1px solid var(--ig-purple);
		border-radius: 999px;
	}

	/* Block 2: four artifacts around «Change». */
	.ig-cycle {
		position: relative;
	}
	.ig-hub {
		margin: 0 0 0.6em;
		font-weight: 700;
		color: var(--ig-orange);
	}
	.ig-ring {
		display: none;
	}
	.ig-cycle-list {
		display: grid;
		gap: 0.6em;
	}
	.ig-artifact {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		column-gap: 0.6em;
		align-items: center;
		padding: 0.6em 0.7em;
		font-size: 0.9em;
		border: 1px solid var(--ig-line);
		border-radius: 0.4rem;
	}
	.ig-artifact > code {
		justify-self: start;
		font-weight: 600;
	}
	.ig-artifact > span {
		grid-column: 2;
		color: var(--ig-muted);
	}

	.ig-links {
		margin: 0.9em 0 0;
		font-size: 0.85em;
		color: var(--ig-muted);
	}
	.ig-links a {
		color: var(--ig-ink);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}
	.ig-links a:hover {
		color: var(--ig-c);
	}

	/* Wide container: two columns filled top to bottom, so DOM order 1-2 / 3-4
	   lands as 1 and 2 on the left, 3 and 4 on the right (design D4). */
	@container (min-width: 40rem) {
		.ig {
			padding: 1.75em;
		}
		.ig-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-template-rows: auto auto;
			grid-auto-flow: column;
		}
		/* Cycle: clockwise from the top-left, which is also the DOM order. */
		.ig-cycle-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 3.2em 2.6em;
		}
		.ig-artifact:nth-child(1) {
			grid-area: 1 / 1;
		}
		.ig-artifact:nth-child(2) {
			grid-area: 1 / 2;
		}
		.ig-artifact:nth-child(3) {
			grid-area: 2 / 2;
		}
		.ig-artifact:nth-child(4) {
			grid-area: 2 / 1;
		}
		.ig-artifact {
			position: relative;
			z-index: 1;
			grid-template-columns: minmax(0, 1fr);
			row-gap: 0.25em;
			align-content: start;
			justify-items: start;
			background: var(--ig-paper);
		}
		.ig-artifact > span {
			grid-column: 1;
		}
		.ig-hub {
			position: absolute;
			z-index: 2;
			top: 50%;
			left: 50%;
			margin: 0;
			padding: 0.2em 0.6em;
			background: var(--ig-paper);
			border: 2px solid var(--ig-orange);
			border-radius: 999px;
			transform: translate(-50%, -50%);
		}
		.ig-ring {
			display: block;
			position: absolute;
			top: 50%;
			left: 50%;
			width: 9em;
			height: 9em;
			fill: none;
			stroke: var(--ig-orange);
			stroke-width: 2.5;
			stroke-linecap: round;
			stroke-linejoin: round;
			transform: translate(-50%, -50%);
		}
		.ig-ring circle {
			stroke-dasharray: 6 5;
		}
	}
</style>
