---
/**
 * Lists the `resources` collection grouped by type, with a type filter that works without
 * JavaScript: native radios plus CSS `:has()`. Without `:has()` support every resource stays visible.
 */
import { getCollection } from 'astro:content';
import { RESOURCE_TYPES, RESOURCE_TYPE_LABELS } from '../lib/resources-schema';

const LANG_LABELS = { es: 'Español', en: 'Inglés' } as const;
const GROUP_TITLES = {
	oficial: 'Documentación oficial',
	comunidad: 'Comunidad',
	video: 'Vídeos',
} as const;

const resources = await getCollection('resources');
const groups = RESOURCE_TYPES.map((type) => ({
	type,
	items: resources.filter((r) => r.data.type === type),
})).filter((group) => group.items.length > 0);

const filters = [{ id: 'rt-todos', value: 'todos', label: 'Todos' }].concat(
	RESOURCE_TYPES.map((type) => ({ id: `rt-${type}`, value: type, label: RESOURCE_TYPE_LABELS[type] })),
);
---

<div class="resources not-content">
	<fieldset class="resources-filter">
		<legend>Filtrar por tipo</legend>
		{
			filters.map((filter) => (
				<label for={filter.id}>
					<input
						type="radio"
						id={filter.id}
						name="resource-type"
						value={filter.value}
						checked={filter.value === 'todos'}
					/>
					{filter.label}
				</label>
			))
		}
	</fieldset>

	{
		groups.map((group) => (
			<section class="resources-group" data-group={group.type} aria-labelledby={`grupo-${group.type}`}>
				<h2 id={`grupo-${group.type}`}>{GROUP_TITLES[group.type]}</h2>
				<ul>
					{group.items.map(({ data }) => (
						<li data-type={data.type}>
							<a href={data.url} rel="noopener noreferrer" hreflang={data.lang}>
								{data.title}
							</a>
							<span class="resource-meta">
								<span class="resource-type">{RESOURCE_TYPE_LABELS[data.type]}</span>
								{' · '}
								<span class="resource-lang">{LANG_LABELS[data.lang]}</span>
							</span>
						</li>
					))}
				</ul>
			</section>
		))
	}
</div>

<style>
	.resources-filter {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		padding: 0.75rem 1rem;
		margin-bottom: 1.5rem;
	}
	.resources-filter legend {
		font-weight: 600;
		padding-inline: 0.25rem;
	}
	.resources-filter label {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		cursor: pointer;
	}
	.resources-group h2 {
		font-size: var(--sl-text-h3);
		margin-top: 1.5rem;
	}
	.resources-group ul {
		list-style: none;
		padding: 0;
		margin: 0.5rem 0 0;
	}
	.resources-group li {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.75rem;
		padding: 0.5rem 0;
		border-bottom: 1px solid var(--sl-color-hairline);
	}
	.resource-meta {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
	}

	/* Type filter without JavaScript: hide groups and items that do not match the checked radio. */
	.resources:has(#rt-oficial:checked) [data-group]:not([data-group='oficial']),
	.resources:has(#rt-comunidad:checked) [data-group]:not([data-group='comunidad']),
	.resources:has(#rt-video:checked) [data-group]:not([data-group='video']),
	.resources:has(#rt-oficial:checked) li:not([data-type='oficial']),
	.resources:has(#rt-comunidad:checked) li:not([data-type='comunidad']),
	.resources:has(#rt-video:checked) li:not([data-type='video']) {
		display: none;
	}
</style>
