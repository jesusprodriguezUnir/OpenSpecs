---
import { getCollection } from 'astro:content';

// «En equipo» band (w18): the five /equipo/ pages, titles taken from their frontmatter.
const slugs = ['equipo/jira', 'equipo/azure-devops', 'equipo/ci', 'equipo/gobierno', 'equipo/adopcion'];
const entries = await getCollection('docs', (e) => slugs.includes(e.id));
const links = slugs.map((slug) => {
	const entry = entries.find((e) => e.id === slug);
	if (!entry) throw new Error(`[home] «En equipo» enlaza a «${slug}», que no existe`);
	return { href: `/${slug}/`, title: entry.data.title, desc: entry.data.description };
});
---

<section class="home-seccion en-equipo not-content" aria-labelledby="en-equipo">
	<h2 id="en-equipo">En equipo</h2>
	<p class="seccion-intro">
		OpenSpec rinde de verdad cuando el equipo comparte las specs: backlog, pipeline, gobierno del cambio y
		un plan de adopción.
	</p>
	<ul class="enlaces">
		{
			links.map((l) => (
				<li>
					<a href={l.href}>{l.title}</a>
					{l.desc && <span>{l.desc}</span>}
				</li>
			))
		}
	</ul>
</section>

<style>
	.en-equipo {
		padding: 1.75rem 1.5rem;
		border-radius: var(--os-radius);
		background: var(--os-band-bg);
		color: var(--os-band-text);
	}
	.en-equipo > h2 {
		color: var(--os-band-text);
	}
	.en-equipo .seccion-intro {
		color: var(--os-band-muted);
	}
	.enlaces {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1rem 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	li {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin: 0;
	}
	a {
		font-weight: 600;
		color: var(--os-band-accent);
	}
	li span {
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--os-band-muted);
	}
	@media (min-width: 50rem) {
		.enlaces {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
