---
/**
 * Static delta spec example of the home hero (w18, design.md D4). Text only: the file tabs and the
 * + markers are decorative (aria-hidden, not interactive) and the scenario count is derived
 * from the fragment itself.
 */
type Line = { text: string; kind: 'h2' | 'h3' | 'h4' | 'clause' | 'body' | 'blank'; mark?: '+' };

const lines: Line[] = [
	{ text: '## ADDED Requirements', kind: 'h2' },
	{ text: '', kind: 'blank' },
	{ text: '### Requirement: Cancelar una reserva', kind: 'h3', mark: '+' },
	{ text: 'El sistema SHALL permitir cancelar una reserva', kind: 'body', mark: '+' },
	{ text: 'hasta 24 horas antes de su inicio.', kind: 'body', mark: '+' },
	{ text: '', kind: 'blank' },
	{ text: '#### Scenario: Cancelación a tiempo', kind: 'h4', mark: '+' },
	{ text: '- **WHEN** se cancela con más de 24 h de margen', kind: 'clause', mark: '+' },
	{ text: '- **THEN** la reserva pasa a «cancelada»', kind: 'clause', mark: '+' },
	{ text: '', kind: 'blank' },
	{ text: '#### Scenario: Cancelación fuera de plazo', kind: 'h4', mark: '+' },
	{ text: '- **WHEN** quedan menos de 24 h para el inicio', kind: 'clause', mark: '+' },
	{ text: '- **THEN** se rechaza y se indica el motivo', kind: 'clause', mark: '+' },
];

const scenarios = lines.filter((l) => l.text.startsWith('#### Scenario:')).length;
const tabs = ['proposal.md', 'specs/reservas', 'design.md', 'tasks.md'];
---

<figure class="delta-figura" data-delta-figura>
	<div class="ventana">
		<span class="pestanas" aria-hidden="true">
			{tabs.map((tab, i) => <span class:list={['pestana', { activa: i === 1 }]}>{tab}</span>)}
		</span>
		<pre class="codigo"><code>{lines.map((l) => <span class:list={['linea', l.kind]}><span class="marca" aria-hidden="true">{l.mark ?? ' '}</span>{l.text || ' '}</span>)}</code></pre>
	</div>
	<figcaption>
		Ejemplo de delta spec de un change: <span data-scenario-count>{scenarios}</span> escenarios
		que el agente debe cumplir.
	</figcaption>
</figure>

<style>
	.delta-figura {
		margin: 0;
		min-width: 0;
	}
	.ventana {
		border: 1px solid var(--os-border);
		border-radius: var(--os-radius);
		background: var(--os-surface);
		overflow: hidden;
	}
	.pestanas {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		padding: 0.5rem 0.75rem 0;
		border-bottom: 1px solid var(--os-border);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.pestana {
		padding: 0.35rem 0.6rem;
		border-radius: 0.35rem 0.35rem 0 0;
	}
	.pestana.activa {
		background: var(--sl-color-accent-low);
		color: var(--sl-color-white);
	}
	.codigo {
		margin: 0;
		padding: 1rem 0.75rem;
		overflow-x: auto;
		background: transparent;
		border: 0;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		line-height: 1.7;
		color: var(--sl-color-gray-2);
	}
	.linea {
		display: block;
		white-space: pre-wrap;
		padding-inline-start: 1.5ch;
		text-indent: -1.5ch;
	}
	.marca {
		display: inline-block;
		width: 1.5ch;
		text-indent: 0;
		color: var(--os-tag-added-text);
	}
	.h2 {
		color: var(--os-tag-added-text);
		font-weight: 600;
	}
	.h3,
	.h4 {
		color: var(--sl-color-white);
		font-weight: 600;
	}
	figcaption {
		margin-top: 0.6rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
