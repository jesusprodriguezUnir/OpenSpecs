---
// Six steps of a change (w18, design.md D3). The human review is a step, not a command; verify
// belongs to the expanded profile and points at the chat command reference.
type Step = { name: string; desc: string; note?: string; href?: string };

const steps: Step[] = [
	{ name: '/opsx:explore', note: 'opcional', desc: 'Piensa el cambio con el agente antes de escribir nada.' },
	{ name: '/opsx:propose', desc: 'El agente redacta propuesta, delta specs, diseño y tareas.' },
	{ name: 'Revisión humana', desc: 'Lees y ajustas los artefactos antes de que se escriba código.' },
	{ name: '/opsx:apply', desc: 'El agente implementa las tareas contra la spec acordada.' },
	{
		name: '/opsx:verify',
		note: 'perfil ampliado',
		href: '/referencia/comandos-chat/',
		desc: 'Comprueba que la implementación cumple specs, diseño y tareas.',
	},
	{ name: '/opsx:archive', desc: 'Fusiona las deltas en openspec/specs/ y cierra el change.' },
];
---

<section class="home-seccion not-content" aria-labelledby="ciclo-change">
	<h2 id="ciclo-change">El ciclo de un change</h2>
	<ol class="ciclo" aria-label="Pasos del ciclo de un change">
		{
			steps.map((s, i) => (
				<li class="paso">
					<span class="num" aria-hidden="true">
						{String(i + 1).padStart(2, '0')}
					</span>
					<span class="nombre">
						{s.name.startsWith('/opsx:') ? <code>{s.name}</code> : s.name}
						{s.note && ' '}
						{s.note && s.href && (
							<a class="nota" href={s.href}>
								{s.note}
							</a>
						)}
						{s.note && !s.href && <span class="nota">{s.note}</span>}
					</span>
					<span class="desc">{s.desc}</span>
				</li>
			))
		}
	</ol>
	<p class="mas">
		Más detalle en <a href="/guias/flujo-opsx/">el flujo /opsx paso a paso</a> y en
		<a href="/guias/recetas/">las recetas por tipo de cambio</a>.
	</p>
</section>

<style>
	.ciclo {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.paso {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin: 0;
		padding: 1rem 1.1rem;
		border: 1px solid var(--os-border);
		border-radius: var(--os-radius);
		background: var(--os-surface);
	}
	.num {
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.nombre {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem 0.6rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.nombre code {
		font-size: var(--sl-text-sm);
	}
	.nota {
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		font-weight: 400;
		color: var(--sl-color-gray-3);
	}
	a.nota {
		color: var(--sl-color-text-accent);
	}
	.desc {
		font-size: var(--sl-text-sm);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
	}
	.mas {
		margin: 1rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	@media (min-width: 40rem) {
		.ciclo {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 64rem) {
		.ciclo {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
