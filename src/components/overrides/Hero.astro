---
import Default from '@astrojs/starlight/components/Hero.astro';
import { MANUAL_PDF_PATH, MANUAL_PDF_SIZE } from '../../config/manual.mjs';
import plexSans700 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-700-normal.woff2?url';

const { entry } = Astro.locals.starlightRoute;
const { title = entry.data.title, tagline, actions = [] } = entry.data.hero ?? {};
// Only the landing gets the custom hero; other hero pages (e.g. the 404) keep Starlight's.
const isLanding = Boolean(entry.data.hero) && entry.id !== '404' && !entry.id.endsWith('/404');

// Two-line title: first word on its own line, the rest muted.
const [firstWord = '', ...rest] = title.split(' ');
const restOfTitle = rest.join(' ');

// Decorative terminal. Order matters: --i drives the animation delay.
const lines = [
	{ text: '$ openspec init', kind: 'cmd', indent: false },
	{ text: '/opsx:propose añadir-reservas', kind: 'slash', indent: false },
	{ text: '✓ proposal.md  ✓ specs/reservas/spec.md', kind: 'muted', indent: true },
	{ text: '✓ design.md    ✓ tasks.md', kind: 'muted', indent: true },
	{ text: '/opsx:apply', kind: 'slash', indent: false },
	{ text: '✓ 12/12 tareas · 8 escenarios cubiertos', kind: 'muted', indent: true },
	{ text: '/opsx:archive', kind: 'slash', indent: false },
	{ text: '✓ specs fusionadas → openspec/specs/', kind: 'ok', indent: true },
];
---

{
	isLanding ? (
		<>
			<link rel="preload" href={plexSans700} as="font" type="font/woff2" crossorigin />
			<div class="hero landing-hero not-content">
				<div class="copy">
					<p class="eyebrow">// SPEC-DRIVEN DEVELOPMENT</p>
					<h1 id="_top" data-page-title>
						{firstWord}
						{restOfTitle && (
							<>
								<br />
								<span class="muted">{restOfTitle}</span>
							</>
						)}
					</h1>
					{tagline && <p class="tagline" set:html={tagline} />}
					<div class="actions">
						{actions.map(({ link: href, text, variant }) => (
							<a {href} class:list={['cta', variant === 'primary' ? 'primary' : 'secondary']}>
								{text}
								{variant === 'primary' && ' →'}
							</a>
						))}
					</div>
					<a href={MANUAL_PDF_PATH} class="manual-link" download>
						Manual en PDF <span class="size">{MANUAL_PDF_SIZE}</span>
					</a>
				</div>
				<div class="terminal" aria-hidden="true">
					<div class="bar">
						<span class="dot" />
						<span class="dot" />
						<span class="dot" />
						<span class="name">~/reservas — claude</span>
					</div>
					<div class="body">
						{lines.map((l, i) => (
							<div class:list={['line', l.kind, { indent: l.indent }]} style={`--i:${i}`}>
								{l.text}
							</div>
						))}
						<span class="cursor" />
					</div>
				</div>
			</div>
		</>
	) : (
		<Default />
	)
}

<style>
	.landing-hero {
		display: grid;
		grid-template-columns: 100%;
		align-items: center;
		gap: 2.5rem;
		padding-block: 2rem 1.5rem;
	}
	.copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.5rem;
	}
	.eyebrow {
		margin: 0;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-sm);
		letter-spacing: 0.08em;
		color: var(--sl-color-accent-high);
	}
	h1 {
		margin: 0;
		font-size: clamp(2.75rem, 1.2rem + 6vw, 5.25rem);
		font-weight: 700;
		line-height: 0.95;
		letter-spacing: -0.035em;
		color: var(--sl-color-white);
	}
	.muted {
		color: var(--sl-color-gray-3);
	}
	.tagline {
		margin: 0;
		max-width: 31rem;
		font-size: var(--sl-text-xl);
		line-height: 1.5;
		color: var(--sl-color-gray-2);
		text-wrap: pretty;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.cta {
		padding: 0.9rem 1.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.375rem;
		font-weight: 600;
		text-decoration: none;
		color: var(--sl-color-white);
	}
	.cta.primary {
		background: var(--sl-color-text-accent);
		border-color: var(--sl-color-text-accent);
		color: var(--sl-color-black);
	}
	.cta.primary:hover {
		color: var(--sl-color-black);
		filter: brightness(1.08);
	}
	.manual-link {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.manual-link .size {
		font-family: var(--sl-font-mono);
		color: var(--sl-color-gray-3);
	}
	.cta.secondary:hover {
		border-color: var(--sl-color-gray-3);
	}

	/* The terminal is always dark, in both themes. */
	.terminal {
		overflow: hidden;
		background: #17181c;
		border: 1px solid #24272f;
		border-radius: 0.75rem;
		box-shadow: 0 30px 80px rgba(15, 138, 133, 0.18);
	}
	.bar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1rem;
		border-bottom: 1px solid #24272f;
	}
	.dot {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: #353841;
	}
	.name {
		margin-inline-start: 0.6rem;
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		color: #a0a3ad;
	}
	.body {
		min-height: 18.5rem;
		padding: 1.4rem 1.4rem 1.6rem;
		font-family: var(--sl-font-mono);
		font-size: 0.875rem;
		line-height: 1.85;
		overflow-wrap: anywhere;
	}
	.line {
		color: #eceef2;
	}
	.line.slash {
		color: #b8ece8;
	}
	.line.muted {
		color: #a0a3ad;
	}
	.line.ok {
		color: #4fc7c0;
	}
	.line.indent {
		padding-inline-start: 1.1rem;
	}
	.cursor {
		display: inline-block;
		width: 0.55rem;
		height: 1.05rem;
		vertical-align: middle;
		background: #b8ece8;
	}

	@media (prefers-reduced-motion: no-preference) {
		.line {
			opacity: 0;
			animation: reveal 0.01s forwards;
			animation-delay: calc(var(--i) * 0.5s + 0.3s);
		}
		.cursor {
			animation: blink 1s steps(1) 5;
		}
	}
	@keyframes reveal {
		to {
			opacity: 1;
		}
	}
	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@media (min-width: 50rem) {
		.landing-hero {
			grid-template-columns: 1fr 1fr;
			gap: 3.5rem;
			padding-block: 3.5rem 2.5rem;
		}
	}
</style>
