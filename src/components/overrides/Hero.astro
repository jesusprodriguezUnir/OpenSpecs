---
import Default from '@astrojs/starlight/components/Hero.astro';
import { getCollection } from 'astro:content';
import { MANUAL_PDF_PATH, MANUAL_PDF_SIZE } from '../../config/manual.mjs';
import { referenceVersion } from '../../lib/manual-order';
import DeltaSpecFigura from '../home/DeltaSpecFigura.astro';
import plexSans700 from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-700-normal.woff2?url';

const { entry } = Astro.locals.starlightRoute;
const { title = entry.data.title, tagline, actions = [] } = entry.data.hero ?? {};
// Only the landing gets the custom hero; other hero pages (e.g. the 404) keep Starlight's.
const isLanding = Boolean(entry.data.hero) && entry.id !== '404' && !entry.id.endsWith('/404');
// Reference version of the site: the highest openspecVersion declared by the guides.
const version = isLanding ? referenceVersion(await getCollection('docs')) : undefined;
---

{
	isLanding ? (
		<>
			<link rel="preload" href={plexSans700} as="font" type="font/woff2" crossorigin />
			<div class="hero landing-hero not-content">
				<div class="copy">
					{version && (
						<p class="pill" data-reference-version>
							OpenSpec {version}
						</p>
					)}
					<h1 id="_top" data-page-title>
						{title}
					</h1>
					{tagline && <p class="tagline" set:html={tagline} />}
					<div class="actions">
						{actions.map(({ link: href, text, variant }) => (
							<a {href} class:list={['cta', variant === 'primary' ? 'primary' : 'secondary']}>
								{text}
							</a>
						))}
					</div>
					<a href={MANUAL_PDF_PATH} class="manual-link" download>
						Manual en PDF · <span class="size">{MANUAL_PDF_SIZE}</span>
					</a>
				</div>
				<DeltaSpecFigura />
			</div>
		</>
	) : (
		<Default />
	)
}

<style>
	.landing-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: center;
		gap: 2.5rem;
		padding-block: 2rem 1.5rem;
	}
	.copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
		min-width: 0;
	}
	.pill {
		margin: 0;
		padding: 0.2rem 0.7rem;
		border: 1px solid var(--os-border);
		border-radius: 999px;
		background: var(--os-surface);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	h1 {
		margin: 0;
		font-size: clamp(2.25rem, 1.4rem + 3.6vw, 3.75rem);
		font-weight: 700;
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
	.tagline {
		margin: 0;
		max-width: 34rem;
		font-size: var(--sl-text-lg);
		line-height: 1.55;
		color: var(--sl-color-gray-2);
		text-wrap: pretty;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}
	.cta {
		padding: 0.8rem 1.3rem;
		border: 1px solid var(--os-border);
		border-radius: var(--os-radius);
		background: var(--os-surface);
		font-weight: 600;
		text-decoration: none;
		color: var(--sl-color-white);
	}
	.cta.primary {
		background: var(--sl-color-accent);
		border-color: var(--sl-color-accent);
		color: var(--sl-color-black);
	}
	.cta.primary:hover {
		background: var(--sl-color-accent-high);
		border-color: var(--sl-color-accent-high);
		color: var(--sl-color-black);
	}
	.cta.secondary:hover {
		border-color: var(--sl-color-gray-3);
	}
	.manual-link {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	.manual-link .size {
		font-family: var(--sl-font-mono);
		color: var(--sl-color-gray-3);
	}

	@media (min-width: 50rem) {
		.landing-hero {
			grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
			gap: 3rem;
			padding-block: 3rem 2.5rem;
		}
	}
</style>
