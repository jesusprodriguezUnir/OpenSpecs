---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import ComandosPagina from '../ComandosPagina.astro';
import { hasMetadataHeader } from '../../lib/content-rules';
import { progressInGroup } from '../../lib/progress';
import { getBuildDate, isStale } from '../../lib/staleness';

const { entry, sidebar, toc } = Astro.locals.starlightRoute;
const { level, duration, openspecVersion, lastReviewed, commands } = entry.data;
const showHeader = hasMetadataHeader(entry.id);
const stale = showHeader && lastReviewed !== undefined && isStale(lastReviewed, getBuildDate());
const reviewedLabel = lastReviewed
	? new Intl.DateTimeFormat('es-ES', { dateStyle: 'long', timeZone: 'UTC' }).format(lastReviewed)
	: undefined;
const levelLabel = level ? level.charAt(0).toUpperCase() + level.slice(1) : undefined;
// Progress banner (w18, D6): position of this page in its sidebar group; null hides it.
const progress = progressInGroup(sidebar, Astro.url.pathname);
const percent = progress ? Math.round((progress.index / progress.total) * 100) : 0;
---

{
	progress && (
		<p class="progreso" data-progress>
			<span class="texto">
				{progress.group} · paso {progress.index} de {progress.total}
			</span>
			<span class="barra" aria-hidden="true">
				<span class="relleno" style={`width: ${percent}%`} />
			</span>
		</p>
	)
}
<Default />
{
	showHeader && (
		<dl class="guide-meta" data-guide-meta>
			{levelLabel && (
				<div data-meta="level">
					<dt>Nivel</dt>
					<dd>{levelLabel}</dd>
				</div>
			)}
			{duration !== undefined && (
				<div data-meta="duration">
					<dt>Duración</dt>
					<dd>{duration} min</dd>
				</div>
			)}
			{openspecVersion && (
				<div data-meta="openspec-version">
					<dt>OpenSpec</dt>
					<dd>{openspecVersion}</dd>
				</div>
			)}
			{reviewedLabel && lastReviewed && (
				<div data-meta="last-reviewed">
					<dt>Revisado</dt>
					<dd>
						<time datetime={lastReviewed.toISOString().slice(0, 10)}>{reviewedLabel}</time>
					</dd>
				</div>
			)}
		</dl>
	)
}
{commands && <ComandosPagina commands={commands} class={toc ? 'lg:sl-hidden' : undefined} />}
{
	stale && (
		<aside
			aria-label="Precaución"
			class="starlight-aside starlight-aside--caution"
			data-stale-warning
		>
			<p class="starlight-aside__title" aria-hidden="true">
				Precaución
			</p>
			<div class="starlight-aside__content">
				<p>
					Contenido posiblemente desactualizado: esta página se revisó hace más de 180 días y
					puede no reflejar la versión actual de OpenSpec.
				</p>
			</div>
		</aside>
	)
}

<style>
	.progreso {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 0.75rem;
		margin: 0 0 0.75rem;
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.barra {
		flex: 0 0 6rem;
		height: 0.25rem;
		border-radius: 999px;
		background: var(--os-border);
		overflow: hidden;
	}
	.relleno {
		display: block;
		height: 100%;
		background: var(--sl-color-accent);
	}
	/* Metadata pills: same description list, each term/value pair as a pill. */
	.guide-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0.75rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.guide-meta div {
		display: flex;
		gap: 0.35rem;
		padding: 0.2rem 0.65rem;
		border: 1px solid var(--os-border);
		border-radius: 999px;
		background: var(--os-surface);
	}
	.guide-meta dt {
		color: var(--sl-color-gray-3);
	}
	.guide-meta dt::after {
		content: ':';
	}
	.guide-meta dd {
		margin: 0;
		font-weight: 600;
		color: var(--sl-color-white);
	}
</style>
