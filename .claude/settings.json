{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "OPENSPEC_TELEMETRY": "0",
    "ASTRO_TELEMETRY_DISABLED": "1"
  },
  "permissions": {
    "allow": [
      "Bash(openspec list:*)",
      "Bash(openspec show:*)",
      "Bash(openspec status:*)",
      "Bash(openspec validate:*)",
      "Bash(openspec instructions:*)",
      "Bash(openspec --help)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run preview:*)",
      "Bash(npm run check:*)",
      "Bash(npm run test:*)",
      "Bash(npx astro check:*)",
      "Bash(npx playwright test:*)",
      "Bash(npx vitest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(openspec archive:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Edit(./openspec/specs/**)",
      "Write(./openspec/specs/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.vercel/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "openspec validate --all --strict --no-interactive 1>&2 || exit 2"
          }
        ]
      }
    ]
  }
}
